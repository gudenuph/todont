# Copy to .env and edit. Only the first two really need your attention.
# ---------------------------------------------------------------------------

# The address people will actually use. Emailed links are built from this, so
# a wrong value sends people somewhere that does not exist.
PUBLIC_URL=http://localhost:4310

# Signs the session cookie. Generate one with:
#   openssl rand -base64 48
# Changing it later signs everybody out.
COOKIE_SECRET=change-me-before-anyone-else-uses-this

# Set to true once PUBLIC_URL is https. Leave false for plain http, or the
# browser will refuse to send the session cookie and sign-in will appear to
# fail for no reason.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Who can get in
# ---------------------------------------------------------------------------

# local  = email and password held in this database
# ezmuze = the ezmuze central handshake (only useful if you are ezmuze)
AUTH_PROVIDERS=local
ALLOW_SIGNUP=true

# Always-admin accounts, comma separated. With none, the first account created
# on an empty instance becomes admin.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# With no SMTP_HOST, verification and reset links are written to the container
# log instead of sent — usable, if manual. Gmail needs an App Password.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REQUIRE_VERIFIED_EMAIL=false

# ---------------------------------------------------------------------------
# Rarely changed
# ---------------------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=4310
DATA_DIR=/data
SERVE_WEB=true
WEB_DIST=/app/web/dist
SESSION_DAYS=30
MAX_UPLOAD_BYTES=52428800
MAX_UPLOADS_PER_BUG=10
LOG_LEVEL=info

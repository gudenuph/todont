# Copy to /etc/todont-tracker.env (chmod 600, owned by root) and fill in.

NODE_ENV=production
HOST=127.0.0.1
PORT=4310

PUBLIC_URL=https://bugs.ezmuze.studio
DATA_DIR=/var/lib/todont-tracker

# Serve the built SPA from the same process, so nginx only proxies one upstream.
SERVE_WEB=true
WEB_DIST=/opt/todont-tracker/web/dist

# Signs the session cookie. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
COOKIE_SECRET=CHANGE_ME

# TLS terminates at nginx, so the cookie must be marked secure.
COOKIE_SECURE=true
SESSION_DAYS=30

# ezmuze central user ids (GUIDs) that are always admin, comma separated.
# Leave empty on a fresh install: the first person to sign in becomes admin.
# Afterwards, pin it here so the role survives a database reset.
# Ways in, in the order the sign-in dialog offers them.
#   local  = email and password held in this database (the default)
#   ezmuze = the ezmuze central handshake
AUTH_PROVIDERS=local

# Whether strangers may create their own account.
ALLOW_SIGNUP=true

# Accounts that are always admin, comma separated. Otherwise the first account
# created on an empty instance becomes admin.
ADMIN_EMAILS=
ADMIN_EZMUZE_USER_IDS=

# 50MB — screenshots are tiny, a screen recording is not.
MAX_UPLOAD_BYTES=52428800
MAX_UPLOADS_PER_BUG=10
LOG_LEVEL=info
